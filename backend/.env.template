# PayVault Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# ── Application Settings ──────────────────────────────────────────────────────

# Environment: development, staging, production
APP_ENV=development

# Server port (Render uses 10000, local dev uses 8000)
APP_PORT=8000

# ── Database Configuration ────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
# Local: postgresql://postgres:password@localhost:5432/payvault
# Render: (copy from Render dashboard - includes SSL)
DATABASE_URL=postgresql://user:password@hostname:5432/payvault?sslmode=require

# ── Redis Configuration ───────────────────────────────────────────────────────

# Redis connection string
# Format: redis://username:password@host:port
# Local: redis://localhost:6379
# Render/Upstash: (copy from dashboard)
REDIS_URL=redis://localhost:6379

# ── JWT Security ──────────────────────────────────────────────────────────────

# JWT secret key (MINIMUM 32 characters, use random string!)
# Generate with: openssl rand -base64 48
# Example: 7d8f9a3b2c1e5f6a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2
JWT_SECRET=change-this-to-random-64-character-string-min-32-chars

# Token expiration times (in minutes)
JWT_ACCESS_TTL=15          # 15 minutes for access token
JWT_REFRESH_TTL=10080      # 7 days (10080 minutes) for refresh token

# ── Email Configuration (Gmail SMTP) ──────────────────────────────────────────

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your Gmail credentials
SMTP_USERNAME=nwokolopaul274@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here  # 16-char app password with spaces

# From address for all emails
SMTP_FROM=noreply@payvault.com

# ── Admin Account (Seeded on First Run) ───────────────────────────────────────

# Initial admin user (created automatically)
ADMIN_EMAIL=admin@payvault.com
ADMIN_PASSWORD=Admin123!  # Change this in production!

# ── Payment Gateway (Optional - For Future Integration) ───────────────────────

# Paystack payment gateway
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Monitoring & Analytics (Optional) ─────────────────────────────────────────

# Sentry error tracking (optional)
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzzzzzzzz

# Analytics ID (optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ── Feature Flags (Optional) ──────────────────────────────────────────────────

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOG=true

# ── Rate Limiting (Optional) ──────────────────────────────────────────────────

# API rate limits
RATE_LIMIT_REQUESTS=100    # requests per window
RATE_LIMIT_WINDOW=60       # seconds (1 minute)

# ── CORS Origins (Production Only) ────────────────────────────────────────────

# Allowed frontend domains (comma-separated)
# Add your Vercel domain and custom domain here
ALLOWED_ORIGINS=https://payvault-frontend.vercel.app,https://payvault.ng

# ── File Paths (Advanced) ─────────────────────────────────────────────────────

# Log file location (optional, defaults to stdout)
# LOG_FILE=/var/log/payvault/backend.log

# Database pool size (optional, defaults to 5)
# DATABASE_POOL_SIZE=10

# ──────────────────────────────────────────────────────────────────────────────
# IMPORTANT SECURITY NOTES:
# 
# 1. NEVER commit this file with real values to Git
# 2. Use .env.example as template only
# 3. Store production secrets in secure vault
# 4. Rotate passwords regularly (every 90 days)
# 5. Use different passwords for dev/staging/prod
# 6. Enable 2FA on all accounts
# ──────────────────────────────────────────────────────────────────────────────
