# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payvault

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=10080

# Application
APP_ENV=development
APP_PORT=8000

# SMTP/Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@payvault.com

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin User
ADMIN_EMAIL=admin@payvault.com
ADMIN_PASSWORD=ChangeMe123!
