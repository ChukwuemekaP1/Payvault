# Container runtime
node_modules/

# ============================================
# MISCELLANEOUS
# ============================================

# Temporary files
tmp/
temp/
.tmp/
.tmp

# Backup files
*.bak
*.backup
*.old

# Screenshots
*.png
*.jpg
*.jpeg
*.gif
*.webp
!.qoder/
!.qodo/

# Documentation build
*.md.html

# ALL Markdown files (NOT for GitHub)
# These files are for local reference only
*.md
!.qoder/
!.qodo/
# Except README.md in root and key directories
!README.md
!backend/README.md
!frontend/README.md

# Personal documentation (NOT for GitHub)
# These files are for local reference only
/docs/
/*.md.html
CHANGES.md
CHANGELOG.md
TODO.md
NOTES.md
README.local.md
DEVELOPMENT.local.md
*.local.md

# Scripts and tools (outside backend/frontend)
/scripts/
/tools/
/bin/

# Log files
admin.log
fix.log
docs.log
*.log

# Package manager locks (optional - uncomment if you don't want to commit them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================
# IMPORTANT: What TO COMMIT
# ============================================
# 
# DO commit:
# ✓ Source code (.rs, .tsx, .ts, .js, .jsx)
# ✓ Configuration files (Cargo.toml, package.json)
# ✓ README files
# ✓ Documentation (.md files)
# ✓ .env.example files (templates)
# ✓ SQL migrations
# ✓ Test files
# ✓ Public assets
#
# DON'T commit:
# ✗ Environment variables (.env files)
# ✗ Build outputs (target/, dist/, node_modules/)
# ✗ IDE settings
# ✗ OS files
# ✗ Logs and caches
# ✗ Database files
# ============================================
