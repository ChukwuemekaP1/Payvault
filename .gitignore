# ============================================
# PayVault - Comprehensive Git Ignore
# ============================================

# ============================================
# BACKEND (Rust/Cargo)
# ============================================

# Build output
/target/
**/target/

# Cargo lock file (optional: commit if you want reproducible builds)
Cargo.lock

# Rust backup files
*.rs.bk

# Environment variables (CRITICAL - never commit!)
.env
.env.local
.env.production
.env.*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Rust analyzer and IDE
.rust-analyzer/
*.swp
*.swo
*~

# ============================================
# FRONTEND (Node.js/React)
# ============================================

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Build output
frontend/dist/
frontend/build/

# Environment variables (CRITICAL - never commit!)
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.test
frontend/.env.production
frontend/.env.*.local

# Testing
frontend/coverage/
frontend/.jest-cache/

# Cache
frontend/.cache/
frontend/.eslintcache
frontend/.stylelintcache
frontend/yarn-error.log

# Vite specific
frontend/vite.config.ts.timestamp-*

